# Copy to .env (or export these directly) for running cmd/server or
# cmd/migrate against a local Postgres instead of via docker-compose.

DATABASE_URL=postgres://formstore:formstore@localhost:5433/formstore?sslmode=disable
PORT=3000

# Worker tuning (all optional, sane defaults if unset).
POLL_INTERVAL=5s
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WORKER_STALE_AFTER=2m
